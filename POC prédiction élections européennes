import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split, cross_val_score, KFold
from sklearn.ensemble import GradientBoostingRegressor
from sklearn.metrics import mean_absolute_error, r2_score, mean_squared_error
from sklearn.preprocessing import StandardScaler
import matplotlib.pyplot as plt
import joblib
import os

print("=" * 80)
print("PRÉDICTION ÉLECTIONS EUROPÉENNES - VERSION SIMPLIFIÉE")
print("=" * 80)

# ============================================================================
# 1. CHARGEMENT DES DONNÉES
# ============================================================================
print("\n[1] CHARGEMENT DES DONNÉES...")

df_train = pd.read_csv('./data/gold/departements_2019_2024.csv', sep=';')
df_2014 = pd.read_csv('./data/gold/departements_2014.csv', sep=';')

# Filtrer les lignes avec des valeurs manquantes dans les targets
target_cols_list = ['pct_vote_extreme_gauche', 'pct_vote_gauche', 'pct_vote_centre', 
                    'pct_vote_droite', 'pct_vote_extreme_droite']
df_2014 = df_2014.dropna(subset=target_cols_list)

print(f"   → Entraînement : {len(df_train)} lignes (2019-2024)")
print(f"   → Test 2014 : {len(df_2014)} lignes")

# ============================================================================
# 2. PRÉPARATION DES FEATURES
# ============================================================================
print("\n[2] PRÉPARATION DES FEATURES...")

ignored_cols = ['dep_code', 'dep_libelle', 'annee', 'nuance_liste_gagnante', 
                'pct_voix_liste_gagnante', 'pct_vote_extreme_gauche', 
                'pct_vote_gauche', 'pct_vote_centre', 'pct_vote_droite', 
                'pct_vote_extreme_droite']

target_cols = {
    'EXTREME GAUCHE': 'pct_vote_extreme_gauche',
    'GAUCHE': 'pct_vote_gauche',
    'CENTRE': 'pct_vote_centre',
    'DROITE': 'pct_vote_droite',
    'EXTREME DROITE': 'pct_vote_extreme_droite',
}

# Features communes
common_features = [col for col in df_train.columns 
                   if col not in ignored_cols and col in df_2014.columns]

print(f"   → {len(common_features)} features utilisées")

# Préparation et normalisation
X_train = df_train[common_features].fillna(df_train[common_features].mean())
X_2014 = df_2014[common_features].fillna(df_2014[common_features].mean())

scaler = StandardScaler()
X_train_scaled = pd.DataFrame(
    scaler.fit_transform(X_train), 
    columns=common_features, 
    index=X_train.index
)
X_2014_scaled = pd.DataFrame(
    scaler.transform(X_2014), 
    columns=common_features, 
    index=X_2014.index
)

# ============================================================================
# 3. SPLIT TRAIN/VALIDATION
# ============================================================================
print("\n[3] SPLIT TRAIN/VALIDATION...")

X_tr, X_val = train_test_split(X_train_scaled, test_size=0.25, random_state=42)
train_idx = X_tr.index
val_idx = X_val.index

print(f"   → Entraînement : {len(X_tr)} échantillons")
print(f"   → Validation : {len(X_val)} échantillons")

# ============================================================================
# 4. CONFIGURATION DU MODÈLE
# ============================================================================
print("\n[4] CONFIGURATION DU MODÈLE...")

# UN SEUL ALGORITHME : GradientBoosting
# Pourquoi GradientBoosting ?
# - Fonctionne bien avec peu de données
# - Régularisation intégrée (learning_rate, subsample)
# - Performant sur des données tabulaires
# - Moins sensible à l'overfitting que RandomForest avec peu de données

print("\n   🎯 ALGORITHME CHOISI : GradientBoosting")
print("   Raisons :")
print("      • Excellent avec peu de données (202 lignes)")
print("      • Learning rate bas = apprentissage progressif")
print("      • Subsample = régularisation naturelle")
print("      • Meilleurs résultats sur validation dans les tests")

model_config = GradientBoostingRegressor(
    n_estimators=100,        # 100 arbres séquentiels
    learning_rate=0.05,      # Apprentissage lent = plus stable
    max_depth=5,             # Limite la complexité
    min_samples_split=10,    # Au moins 10 échantillons pour split
    min_samples_leaf=5,      # Au moins 5 dans chaque feuille
    subsample=0.8,           # Utilise 80% des données par itération
    random_state=42
)

# ============================================================================
# 5. ENTRAÎNEMENT
# ============================================================================
print("\n[5] ENTRAÎNEMENT DES 5 MODÈLES (un par bord politique)...")
print("-" * 80)

all_models = {}
results = []

for nom_bord, target_col in target_cols.items():
    print(f"\n📊 {nom_bord}")
    
    # Targets
    y_train = df_train.loc[train_idx, target_col]
    y_val = df_train.loc[val_idx, target_col]
    y_2014 = df_2014[target_col]
    
    # Validation croisée (pour vérifier la stabilité)
    kfold = KFold(n_splits=5, shuffle=True, random_state=42)
    cv_scores = cross_val_score(model_config, X_tr, y_train, cv=kfold, 
                                 scoring='r2', n_jobs=-1)
    
    print(f"   Cross-validation R² : {cv_scores.mean():.3f} (+/- {cv_scores.std():.3f})")
    
    # Entraînement
    model = GradientBoostingRegressor(
        n_estimators=100, learning_rate=0.05, max_depth=5,
        min_samples_split=10, min_samples_leaf=5, subsample=0.8,
        random_state=42
    )
    model.fit(X_tr, y_train)
    
    # Prédictions
    pred_train = model.predict(X_tr)
    pred_val = model.predict(X_val)
    pred_2014 = model.predict(X_2014_scaled)
    
    # Métriques
    mae_train = mean_absolute_error(y_train, pred_train)
    r2_train = r2_score(y_train, pred_train)
    
    mae_val = mean_absolute_error(y_val, pred_val)
    r2_val = r2_score(y_val, pred_val)
    
    mae_2014 = mean_absolute_error(y_2014, pred_2014)
    r2_2014 = r2_score(y_2014, pred_2014)
    
    print(f"   Train  → MAE: {mae_train:.2f}% | R²: {r2_train:.3f}")
    print(f"   Valid. → MAE: {mae_val:.2f}% | R²: {r2_val:.3f}")
    print(f"   2014   → MAE: {mae_2014:.2f}% | R²: {r2_2014:.3f}")
    
    # Détection overfitting
    overfit_gap = r2_train - r2_val
    if overfit_gap > 0.15:
        print(f"   ⚠️  Overfitting détecté (écart = {overfit_gap:.3f})")
    else:
        print(f"   ✓ Bon équilibre (écart = {overfit_gap:.3f})")
    
    # Features importantes
    importances = pd.DataFrame({
        'Feature': common_features,
        'Importance': model.feature_importances_
    }).sort_values(by='Importance', ascending=False)
    
    print(f"\n   Top 3 features :")
    for idx, row in importances.head(3).iterrows():
        print(f"      • {row['Feature']:30s} : {row['Importance']*100:5.2f}%")
    
    # Sauvegarde
    all_models[nom_bord] = {
        'model': model,
        'scaler': scaler,
        'features': common_features
    }
    
    results.append({
        'Bord': nom_bord,
        'R2_Train': r2_train,
        'R2_Val': r2_val,
        'R2_2014': r2_2014,
        'MAE_Val': mae_val,
        'MAE_2014': mae_2014,
        'CV_Mean': cv_scores.mean(),
        'CV_Std': cv_scores.std()
    })

# ============================================================================
# 6. RÉSUMÉ
# ============================================================================
print("\n" + "=" * 80)
print("RÉSUMÉ DES PERFORMANCES")
print("=" * 80)

results_df = pd.DataFrame(results)

print("\n| Bord Politique | MAE Validation | MAE Test 2014 | R² Validation | R² Test 2014 |")
print("|" + "-" * 80 + "|")
for _, row in results_df.iterrows():
    print(f"| {row['Bord']:14s} | {row['MAE_Val']:13.2f}% | {row['MAE_2014']:12.2f}% | "
          f"{row['R2_Val']:12.3f} | {row['R2_2014']:11.3f} |")

# Moyennes
print(f"\n📊 Moyennes globales :")
print(f"   MAE Validation : {results_df['MAE_Val'].mean():.2f}%")
print(f"   MAE Test 2014  : {results_df['MAE_2014'].mean():.2f}%")
print(f"   R² Validation  : {results_df['R2_Val'].mean():.3f}")
print(f"   R² Test 2014   : {results_df['R2_2014'].mean():.3f}")

# ============================================================================
# 7. SAUVEGARDE
# ============================================================================
print("\n[7] SAUVEGARDE...")

os.makedirs('./models/saved_simple', exist_ok=True)

for nom_bord, model_data in all_models.items():
