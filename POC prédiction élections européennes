import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split, cross_val_score, KFold
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
from sklearn.linear_model import Ridge
from sklearn.metrics import mean_absolute_error, r2_score, mean_squared_error
from sklearn.preprocessing import StandardScaler
import matplotlib.pyplot as plt
import joblib
import os

print("=" * 80)
print("PRÉDICTION DES ÉLECTIONS EUROPÉENNES EN FRANCE PAR DÉPARTEMENT")
print("=" * 80)

# ============================================================================
# 1. CHARGEMENT DES DONNÉES
# ============================================================================
print("\n[1] CHARGEMENT DES DONNÉES...")

# Données d'entraînement (2019 et 2024)
df_train = pd.read_csv('./data/gold/departements_2019_2024.csv', sep=';')
print(f"   → Données d'entraînement : {len(df_train)} lignes (2019-2024)")

# Données de test (2014) pour évaluer le pouvoir prédictif
df_2014 = pd.read_csv('./data/gold/departements_2014.csv', sep=';')
print(f"   → Données de test 2014 : {len(df_2014)} lignes")

# ============================================================================
# 2. PRÉPARATION DES FEATURES
# ============================================================================
print("\n[2] PRÉPARATION DES FEATURES...")

# Colonnes à ignorer
ignored_cols = ['dep_code', 'dep_libelle', 'annee', 'nuance_liste_gagnante', 
                'pct_voix_liste_gagnante', 'pct_vote_extreme_gauche', 
                'pct_vote_gauche', 'pct_vote_centre', 'pct_vote_droite', 
                'pct_vote_extreme_droite']

# Variables cibles
target_cols = {
    'EXTREME GAUCHE': 'pct_vote_extreme_gauche',
    'GAUCHE': 'pct_vote_gauche',
    'CENTRE': 'pct_vote_centre',
    'DROITE': 'pct_vote_droite',
    'EXTREME DROITE': 'pct_vote_extreme_droite',
}

# Features communes aux deux datasets
common_features = [col for col in df_train.columns 
                   if col not in ignored_cols and col in df_2014.columns]

print(f"   → {len(common_features)} features communes identifiées :")
for feat in common_features:
    print(f"      • {feat}")

X_train = df_train[common_features].fillna(df_train[common_features].mean())
X_2014 = df_2014[common_features].fillna(df_2014[common_features].mean())

# Normalisation des données (important pour Ridge)
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_2014_scaled = scaler.transform(X_2014)

# Conversion en DataFrame pour garder les noms de colonnes
X_train_scaled = pd.DataFrame(X_train_scaled, columns=common_features, index=X_train.index)
X_2014_scaled = pd.DataFrame(X_2014_scaled, columns=common_features, index=X_2014.index)

# ============================================================================
# 3. SPLIT TRAIN/VALIDATION SUR LES DONNÉES 2019-2024
# ============================================================================
print("\n[3] SPLIT TRAIN/VALIDATION...")

X_tr, X_val = train_test_split(X_train_scaled, test_size=0.25, random_state=42)
train_idx = X_tr.index
val_idx = X_val.index

print(f"   → Entraînement : {len(X_tr)} échantillons")
print(f"   → Validation : {len(X_val)} échantillons")

# ============================================================================
# 4. ENTRAÎNEMENT DES MODÈLES AVEC RÉGULARISATION
# ============================================================================
print("\n[4] ENTRAÎNEMENT DES MODÈLES...")
print("-" * 80)

# Configuration des modèles avec régularisation pour éviter l'overfitting
models_config = {
    'RandomForest': RandomForestRegressor(
        n_estimators=100,
        max_depth=8,           # Limite la profondeur pour éviter l'overfitting
        min_samples_split=10,  # Minimum d'échantillons pour split
        min_samples_leaf=5,    # Minimum dans chaque feuille
        random_state=42
    ),
    'GradientBoosting': GradientBoostingRegressor(
        n_estimators=100,
        learning_rate=0.05,    # Learning rate faible pour plus de stabilité
        max_depth=5,           # Limite la profondeur
        min_samples_split=10,
        min_samples_leaf=5,
        subsample=0.8,         # Utilise 80% des données à chaque itération
        random_state=42
    ),
    'Ridge': Ridge(
        alpha=10.0             # Régularisation L2 pour éviter l'overfitting
    )
}

# Dictionnaire pour stocker tous les modèles
all_models = {}
results = []

for nom_bord, target_col in target_cols.items():
    print(f"\n{'='*80}")
    print(f"ENTRAÎNEMENT : {nom_bord}")
    print(f"{'='*80}")
    
    # Préparation des targets
    y_train = df_train.loc[train_idx, target_col]
    y_val = df_train.loc[val_idx, target_col]
    y_2014 = df_2014[target_col]
    
    best_model = None
    best_score = -float('inf')
    best_model_name = None
    
    for model_name, model in models_config.items():
        print(f"\n   → Modèle : {model_name}")
        
        # Validation croisée sur les données d'entraînement
        kfold = KFold(n_splits=5, shuffle=True, random_state=42)
        cv_scores = cross_val_score(model, X_tr, y_train, cv=kfold, 
                                     scoring='r2', n_jobs=-1)
        
        print(f"      Cross-validation R² : {cv_scores.mean():.3f} (+/- {cv_scores.std():.3f})")
        
        # Entraînement sur tout le set d'entraînement
        model.fit(X_tr, y_train)
        
        # Prédictions
        pred_train = model.predict(X_tr)
        pred_val = model.predict(X_val)
        pred_2014 = model.predict(X_2014_scaled)
        
        # Métriques sur validation
        mae_val = mean_absolute_error(y_val, pred_val)
        r2_val = r2_score(y_val, pred_val)
        rmse_val = np.sqrt(mean_squared_error(y_val, pred_val))
        
        # Métriques sur train (pour détecter l'overfitting)
        mae_train = mean_absolute_error(y_train, pred_train)
        r2_train = r2_score(y_train, pred_train)
        
        # Métriques sur 2014
        mae_2014 = mean_absolute_error(y_2014, pred_2014)
        r2_2014 = r2_score(y_2014, pred_2014)
        rmse_2014 = np.sqrt(mean_squared_error(y_2014, pred_2014))
        
        print(f"      Train  → MAE: {mae_train:.2f}% | R²: {r2_train:.3f}")
        print(f"      Valid. → MAE: {mae_val:.2f}% | R²: {r2_val:.3f} | RMSE: {rmse_val:.2f}%")
        print(f"      2014   → MAE: {mae_2014:.2f}% | R²: {r2_2014:.3f} | RMSE: {rmse_2014:.2f}%")
        
        # Détection de l'overfitting
        overfit_gap = r2_train - r2_val
        if overfit_gap > 0.15:
            print(f"      ⚠️  ATTENTION : Signe d'overfitting (écart R² train-val = {overfit_gap:.3f})")
        else:
            print(f"      ✓ Bon équilibre train-validation")
        
        # Sélection du meilleur modèle basé sur la validation
        if r2_val > best_score:
            best_score = r2_val
            best_model = model
            best_model_name = model_name
        
        # Sauvegarde des résultats
        results.append({
            'Bord_Politique': nom_bord,
