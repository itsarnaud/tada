"""
ENTRAÎNEMENT DES MODÈLES DE PRÉDICTION ÉLECTORALE

Stratégie anti-overfitting :
- Validation croisée 5-fold
- Régularisation des hyperparamètres (max_depth, learning_rate, etc.)
- Split train/validation pour détecter l'overfitting
- Normalisation des features
"""

import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split, cross_val_score, KFold
from sklearn.ensemble import GradientBoostingRegressor
from sklearn.metrics import mean_absolute_error, r2_score
from sklearn.preprocessing import StandardScaler
import matplotlib.pyplot as plt
import joblib
import os

print("=" * 80)
print("ENTRAÎNEMENT DES MODÈLES - PRÉDICTION ÉLECTIONS EUROPÉENNES")
print("=" * 80)

# ============================================================================
# CHARGEMENT DES DONNÉES
# ============================================================================
print("\n[1] CHARGEMENT DES DONNÉES...")

df_train = pd.read_csv('./data/gold/departements_2019_2024.csv', sep=';')
df_2014 = pd.read_csv('./data/gold/departements_2014.csv', sep=';')

# Filtrer les NaN dans les targets
target_cols_list = ['pct_vote_extreme_gauche', 'pct_vote_gauche', 'pct_vote_centre', 
                    'pct_vote_droite', 'pct_vote_extreme_droite']
df_2014 = df_2014.dropna(subset=target_cols_list)

print(f"    Entraînement (2019-2024) : {len(df_train)} lignes")
print(f"    Test (2014)              : {len(df_2014)} lignes")

# ============================================================================
# PRÉPARATION DES FEATURES
# ============================================================================
print("\n[2] PRÉPARATION DES FEATURES...")

# Colonnes à exclure
ignored_cols = ['dep_code', 'dep_libelle', 'annee', 'nuance_liste_gagnante', 
                'pct_voix_liste_gagnante'] + target_cols_list

# Features communes entre 2019-2024 et 2014
common_features = [col for col in df_train.columns 
                   if col not in ignored_cols and col in df_2014.columns]

print(f"    Features utilisées : {len(common_features)}")

# Extraction et normalisation
X_train = df_train[common_features].fillna(df_train[common_features].mean())
X_2014 = df_2014[common_features].fillna(df_2014[common_features].mean())

scaler = StandardScaler()
X_train_scaled = pd.DataFrame(scaler.fit_transform(X_train), 
                               columns=common_features, index=X_train.index)
X_2014_scaled = pd.DataFrame(scaler.transform(X_2014), 
                              columns=common_features, index=X_2014.index)

# ============================================================================
# SPLIT TRAIN/VALIDATION
# ============================================================================
print("\n[3] SPLIT TRAIN/VALIDATION...")

X_tr, X_val = train_test_split(X_train_scaled, test_size=0.25, random_state=42)
train_idx, val_idx = X_tr.index, X_val.index

print(f"    Train      : {len(X_tr)} échantillons")
print(f"    Validation : {len(X_val)} échantillons")

# ============================================================================
# ENTRAÎNEMENT
# ============================================================================
print("\n[4] ENTRAÎNEMENT DES MODÈLES...")
print("\n    Algorithme : GradientBoosting avec régularisation")
print("    - learning_rate = 0.05 (apprentissage lent)")
print("    - max_depth = 5 (limite la complexité)")
print("    - subsample = 0.8 (80% des données par itération)")
print()

# Cibles
target_cols = {
    'EXTREME GAUCHE': 'pct_vote_extreme_gauche',
    'GAUCHE': 'pct_vote_gauche',
    'CENTRE': 'pct_vote_centre',
    'DROITE': 'pct_vote_droite',
    'EXTREME DROITE': 'pct_vote_extreme_droite',
}

all_models = {}
results = []

for nom_bord, target_col in target_cols.items():
    print(f"    {nom_bord}...")
    
    # Préparation des targets
    y_train = df_train.loc[train_idx, target_col]
    y_val = df_train.loc[val_idx, target_col]
    y_2014 = df_2014[target_col]
    
    # Modèle avec régularisation
    model = GradientBoostingRegressor(
        n_estimators=100,
        learning_rate=0.05,
        max_depth=5,
        min_samples_split=10,
        min_samples_leaf=5,
        subsample=0.8,
        random_state=42
    )
    
    # Validation croisée
    kfold = KFold(n_splits=5, shuffle=True, random_state=42)
    cv_scores = cross_val_score(model, X_tr, y_train, cv=kfold, scoring='r2')
    
    # Entraînement
    model.fit(X_tr, y_train)
    
    # Prédictions et métriques
    mae_val = mean_absolute_error(y_val, model.predict(X_val))
    r2_val = r2_score(y_val, model.predict(X_val))
    mae_2014 = mean_absolute_error(y_2014, model.predict(X_2014_scaled))
    r2_2014 = r2_score(y_2014, model.predict(X_2014_scaled))
    
    # Sauvegarde
    all_models[nom_bord] = {'model': model, 'scaler': scaler, 'features': common_features}
    results.append({
        'Bord': nom_bord,
        'MAE_Validation': mae_val,
        'R2_Validation': r2_val,
        'MAE_2014': mae_2014,
        'R2_2014': r2_2014,
        'CV_R2_Mean': cv_scores.mean(),
        'CV_R2_Std': cv_scores.std()
    })

# ============================================================================
# RÉSUMÉ
# ============================================================================
print("\n[5] RÉSUMÉ DES PERFORMANCES\n")

results_df = pd.DataFrame(results)

print("    ┌────────────────┬──────────────┬──────────────┬───────────┬───────────┐")
