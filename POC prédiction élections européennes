print(f"    ✓ ./models/resultats_entrainement.csv")

# ============================================================================
# VISUALISATION
# ============================================================================
print("\n[8] GÉNÉRATION DES GRAPHIQUES...\n")

fig, axes = plt.subplots(1, 3, figsize=(18, 5))
fig.suptitle('Performance des Modèles (Train: 2014+2019 → Test: 2024)', 
